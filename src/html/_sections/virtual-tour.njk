<section class="section virtual-tour" id="about">
    <div class="container">
        <div class="section-header">
            <p class="section-header__subtitle">A Virtual Tour</p>
            <h2 class="section-header__title">Explore Cowork Through Our <img class="section-header__pill"
                    src="/uploads/images/virtual-tour-pill.webp" srcset="/uploads/images/virtual-tour-pill.webp 1x,
             /uploads/images/virtual-tour-pill@2x.webp 2x" alt=""> Lens</h2>
            <p class="section-header__text">Experience the essence of Cowork before setting foot in our dynamic spaces.
                Our immersive video tour gives you a sneak peek into the vibrant atmosphere, cutting-edge facilities,
                and collaborative energy that define the Cowork experience.</p>
            <p class="section-header__buttons">
                <a class="button button--secondary" href="#">Explore Spaces</a>
            </p>
        </div>
        <div class="section-body">
            <div class="virtual-tour__preview">
                <img class="virtual-tour__image" src="/uploads/images/a-virtual-tour.webp" srcset="/uploads/images/a-virtual-tour-800.webp 800w,
        /uploads/images/a-virtual-tour.webp 1312w,
        /uploads/images/a-virtual-tour@2x.webp 2624w" sizes="(width >= 1440px) 1312px,
       (width >= 768px) and (width < 1024px) 700px,
       (width >= 1024px) 100vw,
       calc(100vw - 2.5rem)" width="1312" height="700" loading="lazy" alt="">
                <button class="virtual-tour__play" type="button" data-dialog-open="virtual-tour-video"
                    data-video-id="UYmvFzDuO5k" data-video-title="Virtual tour video"
                    aria-label="Play virtual tour video">
                    <svg class="virtual-tour__icon" viewBox="0 0 128 103" aria-hidden="true">
                        <use href="/assets/icons/sprite.svg#play" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

</section>